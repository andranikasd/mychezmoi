# ─────────────────────────────────────────────────────────────────────────────
#  ~/.config/bash/bashrc  —  entry point for interactive bash sessions
# ─────────────────────────────────────────────────────────────────────────────
[[ $- != *i* ]] && return

# ── History ───────────────────────────────────────────────────────────────────
HISTSIZE=500000
HISTFILESIZE=500000
HISTFILE="$HOME/.bash_history"
HISTCONTROL=ignoreboth:erasedups
HISTTIMEFORMAT='%F %T  '
HISTIGNORE='ls:ll:la:cd:cd -:pwd:exit:date:* --help:* --version'
shopt -s histappend cmdhist
PROMPT_COMMAND='history -a'

_prune_old_history() {
  mkdir -p "$HOME/.cache"
  local stamp="$HOME/.cache/bash_history_pruned"
  local today; today=$(date +%Y-%m-%d)
  [[ -f "$stamp" && "$(< "$stamp")" == "$today" ]] && return
  local cutoff; cutoff=$(date -v-30d +%s 2>/dev/null || date -d '30 days ago' +%s 2>/dev/null)
  [[ -z "$cutoff" ]] && return
  local histfile="${HISTFILE:-$HOME/.bash_history}"
  [[ ! -f "$histfile" ]] && return
  local tmpfile; tmpfile=$(mktemp)
  local keep=1 ts
  while IFS= read -r line; do
    if [[ "$line" =~ ^#([0-9]{10,})$ ]]; then
      ts="${BASH_REMATCH[1]}"
      keep=$(( ts >= cutoff ? 1 : 0 ))
    fi
    (( keep )) && printf '%s\n' "$line" >> "$tmpfile"
  done < "$histfile"
  mv "$tmpfile" "$histfile"
  history -c; history -r
  printf '%s\n' "$today" > "$stamp"
}
_prune_old_history

# ── Shell options ─────────────────────────────────────────────────────────────
shopt -s checkwinsize nocaseglob
[[ "${BASH_VERSINFO[0]}" -ge 4 ]] && shopt -s autocd cdspell dirspell globstar dotglob

# ── Readline ──────────────────────────────────────────────────────────────────
bind 'set completion-ignore-case on'
bind 'set show-all-if-ambiguous on'
bind 'set mark-symlinked-directories on'
bind 'set colored-stats on'
bind 'set visible-stats on'
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'
bind '"\e[1;5C": forward-word'
bind '"\e[1;5D": backward-word'

# ── Load modules ──────────────────────────────────────────────────────────────
_BASH_D="$HOME/.config/bash"
for _mod in exports aliases functions completion prompt; do
  [[ -f "$_BASH_D/$_mod.sh" ]] && source "$_BASH_D/$_mod.sh"
done
unset _mod _BASH_D
